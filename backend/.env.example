# Postgres connection string. For local dev:
#   postgresql://postgres:postgres@localhost:5432/carflip_os
# For Supabase, use the connection string from Project Settings > Database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/carflip_os"

# Long random string used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# How long issued auth tokens stay valid.
JWT_EXPIRES_IN="7d"

# Port the Express server listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN="http://localhost:3000"

# Optional. If set, the AI assistant endpoints call Anthropic's Claude API
# for triage/chat. If unset, those endpoints return a clearly-labeled mock
# response so the rest of the app is still usable without an API key.
ANTHROPIC_API_KEY=""

# Which Claude model to use for AI triage/chat.
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Local folder used to stand in for S3/object storage in dev.
# Swap lib/storage.ts for a real S3-compatible client when you're ready.
UPLOAD_DIR="./uploads"
